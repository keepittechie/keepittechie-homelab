# Example only. Do not put real secrets here.
# Copy to a private .env file only when a local tool needs it.

# Public-safe examples
LAB_DOMAIN=home.example.com
LAB_EXAMPLE_SUBNET=10.10.0.0/24
PUBLIC_DOCS_MODE=true

# DNS / dashboard placeholders
PIHOLE_PRIMARY_URL=https://pihole1.home.example.com/admin
PIHOLE_SECONDARY_URL=https://pihole2.home.example.com/admin
PIHOLE_API_TOKEN=REPLACE_ME

# Monitoring placeholders
GRAFANA_URL=https://grafana.home.example.com
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
PROMETHEUS_URL=https://prometheus.home.example.com

# Reverse proxy / public access placeholders
REVERSE_PROXY_URL=https://proxy.home.example.com
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# Local AI placeholders
LOCAL_AI_BASE_URL=https://ai.home.example.com/v1
OPENWEBUI_URL=https://openwebui.home.example.com
LOCAL_AI_API_KEY=REPLACE_ME

# Personal app placeholders
FINANCEHQ_URL=https://finance.home.example.com
CAREERFILL_URL=https://career.home.example.com

# Automation placeholders
AWX_URL=https://awx.home.example.com
AWX_TOKEN=REPLACE_ME
